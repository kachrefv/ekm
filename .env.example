# Environment variables template for EKM

# Database configuration
DATABASE_URL=sqlite:///./ekm.db

# Providers: OpenRouter serves both the LLM and the embeddings (one key)
LLM_PROVIDER=openrouter
EMBEDDING_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
# LLM model (OpenRouter model ID)
OPENROUTER_LLM_MODEL=anthropic/claude-haiku-5.5
# Embedding model (see https://openrouter.ai/api/v1/embeddings/models).
# Changing it changes the vector space: re-train existing workspaces afterwards.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Performance settings
SEMANTIC_THRESHOLD=0.82
TOP_K_RESULTS=5
CHUNK_MIN_SIZE=512
CHUNK_MAX_SIZE=2048

# Scalability settings
FAISS_ENABLED=true
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# Debug settings
DEBUG_MODE=false